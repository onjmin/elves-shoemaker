# 小人が作業場として使い倒すディレクトリ（絶対パス推奨）
BASE_DIR=/app/workspace

# 小人の脳みそ (LLM) への接続設定
#
# ── 注意: このプロジェクトは Docker Desktop ではなく、WSL2 の中に Docker Engine を
# 直接インストールする構成（GETTING_STARTED.md 1.3節）。そのため host.docker.internal
# （host-gateway）が指す「ホスト」は WSL2 自身であり、Windows ではない。
# LM Studio 等が Windows 側で動いている場合、host.docker.internal では到達できない。
#
#   コンテナ → (host-gateway) → WSL2 ↛ Windows（LM Studio）
#
# 必ず Windows 側の LAN IP を直接指定すること（LM Studio の "Reachable at:" に表示される値、
# 例: http://192.168.0.23:1234/v1）。WSL2上のIPアドレス確認手順は GETTING_STARTED.md 1.5節を参照。
#
# host.docker.internal が有効なのは、接続先サービスが WSL2 上で直接（Dockerの外で）
# 動いている場合のみ（かなり稀なケース）。
LLM_BASE_URL=http://192.168.0.23:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model

# 小人からの「進捗報告」や「助けて」が届く窓口
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# GitHub 成果提出用 (PR作成・Push時に使用)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_TARGET_REPO=owner/repo

# Tavily 検索用 (AI特化型検索・高コストなので慎重に)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# ── Game Maker（unj-reze ゲーム生成） ──────────────────────────
# 投稿先の unj-reze。LLM_BASE_URL と同じ理由で host.docker.internal は使えないため、
# 実際に unj-reze が動いているマシンの LAN IP を直接指定する（LLM_BASE_URL と
# 同一マシンとは限らない点に注意。例: 192.168.0.2 と 192.168.0.3 で別々の場合もある）。
UNJ_REZE_API_BASE=http://192.168.0.3:3000
# 1 にすると実際に POST /api/games へ投稿する（0 なら検証+ログ保存のみ）
UNJ_REZE_SUBMIT=0
# 投稿時の作者スラッグ（任意）
UNJ_REZE_CREATOR_SLUG=
# 生成するゲームのテーマ（任意。未指定時はデフォルトテーマ）
GAME_THEME=

# RPGen Search（素材検索API）の認証トークン。
# unj-reze の RPGEN_SEARCH_TOKEN と同じ値。未設定時は UNJ_REZE_API_BASE の
# プロキシ (/api/rpgen/*) 経由で検索する（unj-reze の起動が必要）。
RPGEN_SEARCH_TOKEN=

# 小人の思考ログをファイルに上書き保存する (有効: 1 / 無効: 0)
DEBUG_MODE=1

# 日本語翻訳機能を有効にする (有効: 1 / 無効: 0)
# ※内部でLLMを使用するため、有効時はレスポンス速度が確実に低下します
TRANSLATE_JP=1
