# 小人が作業場として使い倒すディレクトリ（絶対パス推奨）
BASE_DIR=/app/workspace

# 小人の脳みそ (LLM) への接続設定
#
# ── host.docker.internal は「Docker を動かしているマシン自身」だけを指す特殊ホスト名 ──
# LAN上の任意のアドレスに解決されるわけではない点に注意。
#   - LLM (LM Studio 等) が Docker と同じ Windows マシンで動いている
#     → http://host.docker.internal:1234/v1 でOK（docker-compose.yml の extra_hosts で解決される）
#   - LLM が LAN 上の別マシン（例: 192.168.0.3）で動いている
#     → host.docker.internal は使えない。IP を直接指定する: http://192.168.0.3:1234/v1
#       （コンテナは既定のブリッジネットワーク経由で LAN 上の他ホストへ直接到達できるため、
#        追加設定は不要。ただし固定IP or 名前解決できるホスト名が必要）
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model

# 小人からの「進捗報告」や「助けて」が届く窓口
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# GitHub 成果提出用 (PR作成・Push時に使用)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_TARGET_REPO=owner/repo

# Tavily 検索用 (AI特化型検索・高コストなので慎重に)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# ── Game Maker（unj-reze ゲーム生成） ──────────────────────────
# 投稿先の unj-reze。
#   - Docker と同じマシンで動く unj-reze → http://host.docker.internal:3000
#   - LAN上の別マシンで動く unj-reze     → http://192.168.0.3:3000 のようにIPを直接指定
# LLM_BASE_URL と同一マシンとは限らないため、host.docker.internal を安易に使い回さないこと。
UNJ_REZE_API_BASE=http://localhost:3000
# 1 にすると実際に POST /api/games へ投稿する（0 なら検証+ログ保存のみ）
UNJ_REZE_SUBMIT=0
# 投稿時の作者スラッグ（任意）
UNJ_REZE_CREATOR_SLUG=
# 生成するゲームのテーマ（任意。未指定時はデフォルトテーマ）
GAME_THEME=

# RPGen Search（素材検索API）の認証トークン。
# unj-reze の RPGEN_SEARCH_TOKEN と同じ値。未設定時は UNJ_REZE_API_BASE の
# プロキシ (/api/rpgen/*) 経由で検索する（unj-reze の起動が必要）。
RPGEN_SEARCH_TOKEN=

# 小人の思考ログをファイルに上書き保存する (有効: 1 / 無効: 0)
DEBUG_MODE=1

# 日本語翻訳機能を有効にする (有効: 1 / 無効: 0)
# ※内部でLLMを使用するため、有効時はレスポンス速度が確実に低下します
TRANSLATE_JP=1
